# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub — add ".env" to .gitignore

# MongoDB connection string (get free one from MongoDB Atlas: https://www.mongodb.com/cloud/atlas)
MONGO_URI=your_mongodb_connection_string_here

# Any random long string — used to sign login tokens (JWT)
JWT_SECRET=replace_this_with_a_long_random_string

# Server port
PORT=5001

# Google Gemini API key (free tier) - for the chatbot, added in the next step
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 key (free quota) - for course/video recommendations, added later
YOUTUBE_API_KEY=your_youtube_api_key_here
